{
  "name": "lunar-lsp",
  "displayName": "Lunar LSP",
  "description": "AI-powered code review surfaced as LSP diagnostics — inline, in your editor, as you write.",
  "author": "Vedanta Somnathe",
  "license": "MIT",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/theVedanta/lunar"
  },
  "publisher": "thvdnta",
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "ai",
    "code review",
    "lsp",
    "diagnostics",
    "openai"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./client/out/extension",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Lunar LSP",
      "properties": {
        "lunar-lsp.openAIApiKey": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "markdownDescription": "Your OpenAI API key. Get one at https://platform.openai.com/api-keys. Stored machine-scoped so it is not synced across machines."
        },
        "lunar-lsp.model": {
          "scope": "resource",
          "type": "string",
          "default": "gpt-4.1-mini",
          "enum": [
            "gpt-4.1-mini",
            "gpt-4.1",
            "gpt-4o",
            "gpt-4o-mini"
          ],
          "description": "The OpenAI model used for code review."
        },
        "lunar-lsp.maxIssues": {
          "scope": "resource",
          "type": "number",
          "default": 5,
          "description": "Maximum number of issues to surface per file per review pass."
        },
        "lunar-lsp.maxNumberOfProblems": {
          "scope": "resource",
          "type": "number",
          "default": 100,
          "description": "Hard cap on the total number of diagnostics shown per file."
        },
        "lunar-lsp.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Lunar language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "node ./scripts/build.mjs --production",
    "watch": "tsc -b -w",
    "lint": "eslint",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "postinstall": "cd client && pnpm install && cd ../server && pnpm install && cd .."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@vscode/vsce-sign",
      "keytar"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22",
    "@vscode/vsce": "^3.4.2",
    "esbuild": "^0.27.4",
    "eslint": "^9.13.0",
    "mocha": "^10.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
